{
  "name": "@ddsr/codegen",
  "version": "1.0.0",
  "type": "module",
  "description": "Generate typed TypeScript stubs from a DDSR service catalog",
  "license": "EPL-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "ddsr-codegen": "dist/cli.js" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@ddsr/client": "workspace:*",
    "@ddsr/model": "workspace:*"
  },
  "devDependencies": {
    "@ddsr/stubs": "workspace:*",
    "@ddsr/tsm": "workspace:*",
    "@eclipse-daanse/tsm": "0.1.0-next.1",
    "@emfts/core": "0.3.0-next.4",
    "@types/node": "^24.13.3",
    "typescript": "~5.8.0",
    "vitest": "^4.0.0",
    "sax": "^1.4.3"
  }
}
