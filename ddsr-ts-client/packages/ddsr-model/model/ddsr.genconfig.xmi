<?xml version="1.0" encoding="UTF-8"?>
<genconfig:GenConfig xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:genconfig="http://www.emfts.org/genconfig/1.0"
    ecorePackage="http://geckoprojects.org/ddsr/1.0#/">

  <!-- Generation Settings -->
  <generation mode="emf" outputDir="./src"/>

  <!-- Package Settings -->
  <package prefix="DDSR" basePackage="org.gecko.ddsr.model"
      generateFactory="true"
      generatePackage="true"
      generateIndex="true"/>

  <!-- Class Defaults -->
  <classDefaults
      generateInterface="true"
      generateImpl="true"
      rootExtendsClass="BasicEObject"/>

  <!-- Feature Defaults -->
  <featureDefaults notify="true" property="editable"/>

</genconfig:GenConfig>
