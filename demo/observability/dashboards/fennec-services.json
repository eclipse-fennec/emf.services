    },
    {
      "type": "table",
      "title": "Recent traces (Tempo)",
      "description": "A consumer call, the broker lookup it needed and the provider that answered it \u2014 one trace, because the context travels in traceparent over REST and in the CloudEvents extensions over MQTT.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceqlSearch",
          "limit": 20,
          "tableType": "traces",
          "filters": [
            {
              "id": "namespace",
              "tag": "service.namespace",
              "operator": "=",
              "scope": "resource",
              "value": [
                "fennec.services"
              ],
              "valueType": "string"
            }
          ],
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "logs",
      "title": "What the three of them logged",
      "description": "The same pipeline as the traces, so a line written inside a call carries its trace id.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_namespace=\"fennec.services\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
