{
  "realm": "fennec",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "service-provider",
        "description": "may announce, change, withdraw and keep alive implementations, and add contracts (SECURITY.md \u00a73)"
      },
      {
        "name": "service-consumer",
        "description": "may look up, hold a session and hear the event stream"
      },
      {
        "name": "service-admin",
        "description": "may curate the catalog and read the whole registry"
      },
      {
        "name": "ledger-reader",
        "description": "may read the RSA example's ledger"
      },
      {
        "name": "ledger-writer",
        "description": "may write it \u2014 held by nobody in the harness, so the refusal is proven"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "description": "sub and auth_time, as Keycloak's own basic scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "realm roles as realm_access.roles, as Keycloak's own roles scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "ddsr-broker",
      "description": "a token for the broker \u2014 asked for explicitly, so no other token carries it",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "ddsr-broker-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ddsr-broker",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "rsa-example",
      "description": "a token for what the RSA example serves",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "rsa-example-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "rsa-example",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "ts-ledger",
      "description": "a token for what the TypeScript ledger serves",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "ts-ledger-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ts-ledger",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "person-store",
      "description": "a token for the PersonStore the Java provider serves in scenario M",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "person-store-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "person-store",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "basic",
    "roles"
  ],
  "defaultOptionalClientScopes": [],
  "clients": [
    {
      "clientId": "harness",
      "name": "harness",
      "description": "the harness script itself: its curl checks against the broker",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "harness-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "optionalClientScopes": [
        "ddsr-broker",
        "ts-ledger"
      ]
    },
    {
      "clientId": "payment-java",
      "name": "payment-java",
      "description": "the Java payment provider, every instance of it (A, F, G, H, J, M)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "payment-java-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "optionalClientScopes": [
        "ddsr-broker"
      ]
    },
    {
      "clientId": "ts-provider",
