# The three run lists of the project libraries, read from the directories
# the library ships, plus what a downstream launch brings itself: the
# HTTP stack and Jersey, Declarative Services, Configuration Admin — and
# here the test framework. If a bundle a list needs is missing from it,
# something in the list does not resolve and RunListsTest says which.
-runfw: org.apache.felix.framework
-runee: JavaSE-21

-tester: biz.aQute.tester.junit-platform

-library: \
	../org.eclipse.fennec.services.bnd.library.project/library/client;version=file,\
	../org.eclipse.fennec.services.bnd.library.project/library/rsa;version=file,\
	../org.eclipse.fennec.services.bnd.library.project/library/security;version=file

-runproperties: \
	org.osgi.service.http.port=-1

-runbundles: \
	org.eclipse.fennec.services.bnd.library.itest;version=snapshot,\
	assertj-core;version='[3.27.7,3.27.8)',\
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-engine;version='[5.14.2,5.14.3)',\
	junit-jupiter-params;version='[5.14.2,5.14.3)',\
	junit-platform-commons;version='[1.14.2,1.14.3)',\
	junit-platform-engine;version='[1.14.2,1.14.3)',\
	junit-platform-launcher;version='[1.14.2,1.14.3)',\
	net.bytebuddy.byte-buddy;version='[1.18.4,1.18.5)',\
	org.opentest4j;version='[1.3.0,1.3.1)',\
	org.apache.felix.scr;version='[2.2.12,2.2.13)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.7,1.3.8)',\
	org.objectweb.asm;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.commons;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.tree;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.tree.analysis;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.util;version='[9.9.1,9.9.2)',\
	jakarta.activation-api;version='[2.1.3,2.1.4)',\
	jakarta.annotation-api;version='[2.1.1,2.1.2)',\
	jakarta.inject.jakarta.inject-api;version='[2.0.1,2.0.2)',\
	jakarta.validation.jakarta.validation-api;version='[3.0.2,3.0.3)',\
	jakarta.ws.rs-api;version='[3.1.0,3.1.1)',\
	jakarta.xml.bind-api;version='[4.0.2,4.0.3)',\
	javassist;version='[3.29.2,3.29.3)',\
	org.apache.felix.http.jetty12;version='[1.1.0,1.1.1)',\
	org.apache.commons.commons-fileupload;version='[1.6.0,1.6.1)',\
	org.apache.commons.commons-io;version='[2.22.0,2.22.1)',\
	org.apache.felix.http.servlet-api;version='[6.1.0,6.1.1)',\
	org.eclipse.osgitech.rest;version='[1.2.3,1.2.4)',\
	org.eclipse.osgitech.rest.servlet.whiteboard;version='[1.2.3,1.2.4)',\
	org.eclipse.osgitech.rest.sse;version='[1.2.3,1.2.4)',\
	org.eclipse.parsson.jakarta.json;version='[1.1.7,1.1.8)',\
	org.glassfish.hk2.api;version='[3.0.5,3.0.6)',\
	org.glassfish.hk2.external.aopalliance-repackaged;version='[3.0.5,3.0.6)',\
	org.glassfish.hk2.locator;version='[3.0.5,3.0.6)',\
	org.glassfish.hk2.osgi-resource-locator;version='[1.0.3,1.0.4)',\
	org.glassfish.hk2.utils;version='[3.0.5,3.0.6)',\
	org.glassfish.jersey.containers.jersey-container-servlet;version='[3.1.3,3.1.4)',\
	org.glassfish.jersey.containers.jersey-container-servlet-core;version='[3.1.3,3.1.4)',\
	org.glassfish.jersey.core.jersey-client;version='[3.1.3,3.1.4)',\
	org.glassfish.jersey.core.jersey-common;version='[3.1.3,3.1.4)',\
	org.glassfish.jersey.core.jersey-server;version='[3.1.3,3.1.4)',\
	org.glassfish.jersey.inject.jersey-hk2;version='[3.1.3,3.1.4)',\
	org.glassfish.jersey.media.jersey-media-jaxb;version='[3.1.3,3.1.4)',\
	org.glassfish.jersey.media.jersey-media-sse;version='[3.1.3,3.1.4)',\
	org.osgi.service.jakartars;version='[2.0.0,2.0.1)',\
	org.osgi.service.servlet;version='[2.0.0,2.0.1)',\
	slf4j.api;version='[2.0.17,2.0.18)',\
	slf4j.simple;version='[2.0.17,2.0.18)'
