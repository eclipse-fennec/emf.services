# enableFennecServicesAmqp — the AMQP 0-9-1 transport in a launch, on top
# of the client (enableFennecServicesClient): calling services announced
# over AMQP and serving a contract on routing keys. Both parts are
# dormant until a flavor names a broker, so the bundles are safe in a
# launch that speaks only REST.
#
# The connection is a Gecko Messaging instance (amqp), which each part
# configures for itself — so this list needs the Configuration Admin
# service the launch chooses anyway, and brings the messaging bundles,
# the RabbitMQ client they drive and the Netty 4.2 that client requires.
# The messaging link and its API are named here as in
# enableFennecServicesMqtt; a launch with both lists names them twice,
# which is one bundle each.
fennec.services.range: [0.1.0,0.2.0)

-runbundles.fennec.services.amqp: \
	org.eclipse.fennec.services.client.amqp;version='${fennec.services.range}',\
	org.eclipse.fennec.services.flavor.amqp;version='${fennec.services.range}',\
	org.eclipse.fennec.services.provider.amqp;version='${fennec.services.range}',\
	org.eclipse.fennec.services.messaging;version='${fennec.services.range}',\
	org.gecko.messaging.api;version='[2.0.0,2.1.0)',\
	org.gecko.messaging.core;version='[2.0.0,2.1.0)',\
	org.gecko.messaging.amqp;version='[2.0.0,2.1.0)',\
	org.osgi.util.pushstream;version='[1.1.0,1.1.1)',\
	com.rabbitmq.client;version='[5.37.0,5.37.1)',\
	io.netty.common;version='[4.2.20,4.2.21)',\
	io.netty.buffer;version='[4.2.20,4.2.21)',\
	io.netty.resolver;version='[4.2.20,4.2.21)',\
	io.netty.transport;version='[4.2.20,4.2.21)',\
	io.netty.transport-native-unix-common;version='[4.2.20,4.2.21)',\
	io.netty.codec-base;version='[4.2.20,4.2.21)',\
	io.netty.handler;version='[4.2.20,4.2.21)'
