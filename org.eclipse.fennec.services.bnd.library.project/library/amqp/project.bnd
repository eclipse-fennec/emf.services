# enableFennecServicesAmqp — a project that names AMQP placements itself
# (exchange, routing keys, message form). Most need nothing at compile
# time: the contract says where a call travels, and the distribution
# reads it.
fennec.services.range: [0.1.0,0.2.0)

-buildpath.fennec.services.amqp: \
	org.eclipse.fennec.services.flavor.messaging;version='${fennec.services.range}'
