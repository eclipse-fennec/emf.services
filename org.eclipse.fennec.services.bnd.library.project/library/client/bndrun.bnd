# enableFennecServicesClient — what a launch of such a project runs, on
# top of an HTTP stack and Jersey (enableJakartaREST), Declarative
# Services and a configuration stack, which the launch chooses itself.
fennec.services.range: [0.1.0,0.2.0)

-runbundles.fennec.services.client: \
	org.eclipse.fennec.services.api;version='${fennec.services.range}',\
	org.eclipse.fennec.services.model;version='${fennec.services.range}',\
	org.eclipse.fennec.services.runtime;version='${fennec.services.range}',\
	org.eclipse.fennec.services.client.java;version='${fennec.services.range}',\
	org.eclipse.fennec.services.client.rest;version='${fennec.services.range}',\
	org.eclipse.fennec.services.flavor.rest;version='${fennec.services.range}',\
	org.eclipse.fennec.services.xmi.codec;version='${fennec.services.range}',\
	org.eclipse.fennec.services.cloudevents;version='${fennec.services.range}',\
	io.cloudevents.model;version='[1.0.2,1.0.3)',\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)',\
	org.eclipse.emf.ecore;version='[2.41.0,2.41.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.39.0,2.39.1)',\
	org.eclipse.fennec.emf.osgi.component.minimal;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.protobuf;version='[1.0.0,1.0.1)',\
	org.eclipse.fennec.protobuf.osgi;version='[1.0.0,1.0.1)',\
	com.google.protobuf;version='[4.35.1,4.35.2)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)'
