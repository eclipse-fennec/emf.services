# enableFennecServicesMqtt — the messaging transport in a launch, with
# the MQTT binding, on top of the client (enableFennecServicesClient):
# calling services announced over MQTT, hearing the broker's events over
# it, and serving a contract on topics. Every part is dormant until
# configured or until a flavor names a broker, so the bundles are safe
# in a launch that speaks only REST.
#
# The transport itself is one for every protocol: the same invoker and
# the same distribution serve MQTT and AMQP, and the flavor says the
# rest. What this list adds to them is what makes MQTT spoken here — the
# mqtt3 binding of Gecko Messaging and the Paho build it drives. The
# connection is a messaging instance each part configures for itself,
# so the list needs the Configuration Admin service the launch chooses
# anyway. enableFennecServicesAmqp names the same transport bundles with
# the other binding; a launch with both lists names them twice, which is
# one bundle each.
fennec.services.range: [0.1.0,0.2.0)

-runbundles.fennec.services.mqtt: \
	org.eclipse.fennec.services.client.messaging;version='${fennec.services.range}',\
	org.eclipse.fennec.services.provider.messaging;version='${fennec.services.range}',\
	org.eclipse.fennec.services.flavor.messaging;version='${fennec.services.range}',\
	org.eclipse.fennec.services.flavor.mqtt;version='${fennec.services.range}',\
	org.eclipse.fennec.services.flavor.amqp;version='${fennec.services.range}',\
	org.eclipse.fennec.services.messaging;version='${fennec.services.range}',\
	org.gecko.messaging.api;version='[2.0.0,2.1.0)',\
	org.gecko.messaging.core;version='[2.0.0,2.1.0)',\
	org.osgi.util.pushstream;version='[1.1.0,1.1.1)',\
	org.gecko.messaging.mqtt3;version='[2.0.0,2.1.0)',\
	org.eclipse.paho.client.mqttv3;version='[1.3.0,1.3.1)'
