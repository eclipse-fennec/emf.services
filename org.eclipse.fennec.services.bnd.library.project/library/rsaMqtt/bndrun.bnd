# enableFennecServicesRsaMqtt — Remote Service Admin over MQTT: the
# distribution for the flavor fennec.mqtt and the discovery that hears
# the broker's events over MQTT, on top of enableFennecServicesRsa and
# enableFennecServicesMqtt. Chosen per node through the role's flavor
# and discovery.flavor. The distribution bundle is the one
# enableFennecServicesRsaAmqp names: it carries a provider per
# configuration type.
fennec.services.range: [0.1.0,0.2.0)

-runbundles.fennec.services.rsa.mqtt: \
	org.eclipse.fennec.services.rsa.distribution.messaging;version='${fennec.services.range}',\
	org.eclipse.fennec.services.rsa.discovery.mqtt;version='${fennec.services.range}'
