Bundle-Name: Fennec Services Broker Core
Bundle-Description: \
	The broker itself: an in-memory RemoteServiceRegistry with XMI \
	snapshot persistence, behind the API in \
	org.eclipse.fennec.services.broker.api. A framework that only talks \
	to a broker needs that bundle, not this one.

-library: enableEMF

Private-Package: \
	org.eclipse.fennec.services.broker.core.internal

-buildpath: \
	osgi.core;version=latest,\
	org.osgi.service.condition;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.metatype.annotations;version=latest,\
	org.osgi.service.cm;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.eclipse.fennec.services.model;version=snapshot,\
	org.eclipse.fennec.services.xmi.codec;version=snapshot,\
	org.eclipse.fennec.services.broker.api;version=snapshot

# Plain JUnit, no OSGi runtime: DdsrBrokerImpl is deliberately pure Java
# (see its class comment) and takes its collaborators as constructor
# arguments, so it needs no framework to exercise.
#
# junit-platform-launcher is not part of the ${junit} macro from the
# fennec osgitest library, but Gradle needs one matching the
# platform-engine version — otherwise test discovery dies with
# "OutputDirectoryCreator not available; probably due to unaligned
# versions".
#
# The four m2x OCL bundles are pinned to the 0.1.1 line (same range as the
# broker bndruns). A bare `latest` is fragile here: the fennecM2X index
# (central.mvn) and the fennecPersistence index both list m2x bundles, and
# when the two drift apart `latest` mixes lines — a 0.1.1 ocl.model with a
# 0.1.0 parser died with NoSuchMethodError (OclFactory.createClassifierType).
-testpath: \
	${junit},\
	junit-platform-launcher;version=latest,\
	org.eclipse.fennec.m2x.ocl.api;version="[0.1.1,0.1.2)",\
	org.eclipse.fennec.m2x.ocl.engine;version="[0.1.1,0.1.2)";packages='*',\
	org.eclipse.fennec.m2x.ocl.model;version="[0.1.1,0.1.2)",\
	org.eclipse.fennec.m2x.ocl.parser;version="[0.1.1,0.1.2)",\
	org.eclipse.fennec.m2x.unit;version="[0.1.1,0.1.2)",\
	org.antlr.antlr4-runtime;version=latest
