# Harness launch variant (FR-P4 Scenario D): identical to the base
# launch plus the itest MQTT config bundle, which wakes the dormant
# MQTT transports against the Mosquitto container.
-runfw: org.apache.felix.framework

-runee: JavaSE-21

-runsystemcapabilities: ${native_capability}

-resolve.effective: active;skip:="osgi.service"

# enabled the runbundles for the Jersey dependencies
-library: enableJakartaREST

# The library contributes -runbundles.jersey with a SECOND, older HTTP
# stack (org.apache.felix.http.jetty 5.x + servlet-api 2.1 + slf4j 1.7)
# on top of the jetty12 bundles pinned below — two competing HTTP
# whiteboards in every launch, which made container startups take
# minutes (found by the FR-P4 podman harness). All required Jersey
# bundles are pinned explicitly in -runbundles, so the library's list
# is emptied here.
jersey.deps:

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.services.itest.mqtt.config',\
	bnd.identity;id='org.eclipse.fennec.services.broker.rest',\
	bnd.identity;id='org.eclipse.fennec.mcp.gogo.runtime.config',\
	bnd.identity;id='org.eclipse.fennec.services.broker.core',\
	bnd.identity;id='org.eclipse.fennec.m2x.ocl.engine',\
	bnd.identity;id='org.eclipse.fennec.services.broker.mqtt',\
	bnd.identity;id='org.eclipse.osgitech.rest.sse',\
	bnd.identity;id='org.apache.felix.configadmin.plugin.interpolation'
# we need to run our project
-runbundles.project: \
	org.eclipse.osgitech.rest.servlet.whiteboard;version=latest,\
	org.eclipse.parsson.jakarta.json;version=latest,\
	org.eclipse.fennec.services.broker.rest;version=snapshot

-runblacklist: \
	bnd.identity;id='org.osgi.service.cm'

# Avoid To have the default Jetty run at port 8080	
# felix.cm.config.plugins: configadmin holds every configuration back until the
# interpolation plugin is registered, so the $[env:...] placeholders in the
# broker's configurator JSON can never be delivered verbatim (which would make
# the port a literal string and the public URL an unparseable URI).
-runproperties: \
	org.osgi.service.http.port=-1,\
	felix.cm.config.plugins=org.apache.felix.configadmin.plugin.interpolation
-runbundles: \
	com.ethlo.time.itu;version='[1.14.0,1.14.1)',\
	io.projectreactor.reactor-core;version='[3.7.0,3.7.1)',\
	jakarta.activation-api;version='[2.1.3,2.1.4)',\
	jakarta.annotation-api;version='[2.1.1,2.1.2)',\
	jakarta.inject.jakarta.inject-api;version='[2.0.1,2.0.2)',\
	jakarta.validation.jakarta.validation-api;version='[3.0.2,3.0.3)',\
	jakarta.ws.rs-api;version='[3.1.0,3.1.1)',\
	jakarta.xml.bind-api;version='[4.0.2,4.0.3)',\
	javassist;version='[3.29.2,3.29.3)',\
	org.apache.commons.commons-fileupload;version='[1.6.0,1.6.1)',\
	org.apache.felix.cm.json;version='[2.0.6,2.0.7)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.configadmin.plugin.interpolation;version='[1.2.8,1.2.9)',\
	org.apache.felix.configurator;version='[1.0.18,1.0.19)',\
	org.apache.felix.gogo.command;version='[1.1.2,1.1.3)',\
	org.apache.felix.gogo.runtime;version='[1.1.6,1.1.7)',\
	org.apache.felix.gogo.shell;version='[1.1.4,1.1.5)',\
	org.apache.felix.http.jetty12;version='[1.1.0,1.1.1)',\
	org.apache.felix.http.servlet-api;version='[6.1.0,6.1.1)',\
	org.apache.felix.scr;version='[2.2.12,2.2.13)',\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)',\
	org.eclipse.emf.ecore;version='[2.41.0,2.41.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.39.0,2.39.1)',\
	org.eclipse.fennec.codec.api;version='[0.1.0,0.1.1)',\
