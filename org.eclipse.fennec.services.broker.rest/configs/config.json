{
  ":configurator:resource-version": 1,

	"org.apache.felix.http~ddsrHttp":
	{
		"org.osgi.service.http.port": "$[env:DDSR_HTTP_PORT;default=8887]",
		"org.osgi.service.http.host": "$[env:DDSR_HTTP_HOST;default=0.0.0.0]",
		"org.apache.felix.http.context_path": "ddsr",
		"org.apache.felix.http.name": "DDSR HTTP",
		"org.apache.felix.http.runtime.init.id": "ddsrHttp",
		"org.apache.felix.http.enable": "$[env:DDSR_HTTP_ENABLE;default=true]",
		"org.apache.felix.https.enable": "$[env:DDSR_HTTPS_ENABLE;default=false]",
		"org.osgi.service.http.port.secure": "$[env:DDSR_HTTPS_PORT;default=8443]",
		"org.apache.felix.https.keystore": "$[env:DDSR_HTTPS_KEYSTORE;default=]",
		"org.apache.felix.https.keystore.password": "$[env:DDSR_HTTPS_KEYSTORE_PASSWORD;default=]",
		"org.apache.felix.https.keystore.key.password": "$[env:DDSR_HTTPS_KEYSTORE_PASSWORD;default=]",
		"org.apache.felix.https.keystore.type": "$[env:DDSR_HTTPS_KEYSTORE_TYPE;default=PKCS12]",
		"org.apache.felix.https.truststore": "$[env:DDSR_HTTPS_TRUSTSTORE;default=]",
		"org.apache.felix.https.truststore.password": "$[env:DDSR_HTTPS_TRUSTSTORE_PASSWORD;default=]",
		"org.apache.felix.https.truststore.type": "$[env:DDSR_HTTPS_TRUSTSTORE_TYPE;default=PKCS12]",
		"org.apache.felix.https.clientcertificate": "$[env:DDSR_HTTPS_CLIENT_CERTIFICATE;default=none]"
	},
	"JakartarsServletWhiteboardRuntimeComponent~ddsrRest":
	{
		"jersey.jakartars.whiteboard.name" : "DDSR Rest",
		"jersey.context.path" : "rest",
		"osgi.http.whiteboard.target" : "(id=ddsrHttp)"
	},
	"org.eclipse.fennec.services.broker.core":
	{
		"domain": "$[env:DDSR_DOMAIN;default=]"
	},
	"org.eclipse.fennec.services.broker.rest":
	{
		"public.url": "$[env:DDSR_PUBLIC_URL;default=http://localhost:8887/ddsr/rest]",
		"auth.mode": "$[env:DDSR_AUTH_MODE;default=$[prop:fennec.auth.mode;default=bearer]]",
		"issuer": "$[env:DDSR_JWT_ISSUER;default=]",
		"audiences": "$[env:DDSR_JWT_AUDIENCES;default=ddsr-broker;type=String[];delimiter=,]",
		"jwks.uri": "$[env:DDSR_JWT_JWKS_URI;default=]",
		"scope.claim": "$[env:DDSR_JWT_SCOPE_CLAIM;default=scope]",
		"trusted.issuers": "$[env:DDSR_MTLS_TRUSTED_ISSUERS;default=;type=String[];delimiter=|]"
	},
	"org.eclipse.fennec.services.security.mtls":
	{
		"trusted.issuers": "$[env:DDSR_MTLS_TRUSTED_ISSUERS;default=;type=String[];delimiter=|]",
		"roles": "$[env:DDSR_MTLS_ROLES;default=;type=String[];delimiter=|]",
		"gateway.header": "$[env:DDSR_MTLS_GATEWAY_HEADER;default=]",
		"gateway.addresses": "$[env:DDSR_MTLS_GATEWAY_ADDRESSES;default=;type=String[];delimiter=,]"
	},
	"org.eclipse.fennec.services.security.jwt":
	{
		"issuer": "$[env:DDSR_JWT_ISSUER;default=]",
		"jwks.uri": "$[env:DDSR_JWT_JWKS_URI;default=]",
		"audiences": "$[env:DDSR_JWT_AUDIENCES;default=ddsr-broker;type=String[];delimiter=,]",
		"scope.claim": "$[env:DDSR_JWT_SCOPE_CLAIM;default=scope]",
		"subject.claim": "$[env:DDSR_JWT_SUBJECT_CLAIM;default=sub]"
	},
	"org.eclipse.fennec.services.broker.rest.application":
	{
		"fennec.auth": "$[env:DDSR_AUTH_MODE;default=$[prop:fennec.auth.mode;default=bearer]]",
		"osgi.jakartars.extension.select": "(osgi.jakartars.name=fennec-auth-$[env:DDSR_AUTH_MODE;default=$[prop:fennec.auth.mode;default=bearer]])"
	},
	"org.eclipse.fennec.services.broker.mqtt":
	{
		"broker.url": "$[env:DDSR_MQTT_URL;default=]",
		"topic.prefix": "$[env:DDSR_MQTT_TOPIC_PREFIX;default=ddsr/events]",
		"client.id": "$[env:DDSR_MQTT_CLIENT_ID;default=ddsr-broker]",
		"event.source": "$[env:DDSR_MQTT_EVENT_SOURCE;default=/fennec/services/broker]",
		"qos": "$[env:DDSR_MQTT_QOS;default=0]",
		"tls.keystore": "$[env:DDSR_MQTT_TLS_KEYSTORE;default=]",
		"tls.keystore.password": "$[env:DDSR_MQTT_TLS_KEYSTORE_PASSWORD;default=]",
		"tls.truststore": "$[env:DDSR_MQTT_TLS_TRUSTSTORE;default=]",
		"tls.truststore.password": "$[env:DDSR_MQTT_TLS_TRUSTSTORE_PASSWORD;default=]"
	},
	"org.eclipse.fennec.services.provider.rest~brokerCatalog":
	{
		"ddsr.contract": "BrokerCatalog",
		"service.filter": "(ddsr.contract=BrokerCatalog)",
		"model.bundle": "org.eclipse.fennec.services.broker.rest",
		"model.entry": "broker-catalog-api.xmi",
		"osgi.jakartars.application.base": "/catalog",
		"fennec.auth": "$[env:DDSR_AUTH_MODE;default=$[prop:fennec.auth.mode;default=bearer]]",
		"osgi.jakartars.extension.select": "(osgi.jakartars.name=fennec-auth-$[env:DDSR_AUTH_MODE;default=$[prop:fennec.auth.mode;default=bearer]])"
	},
	"org.eclipse.fennec.services.provider.rest~brokerImplementations":
	{
		"ddsr.contract": "BrokerImplementations",
		"service.filter": "(ddsr.contract=BrokerImplementations)",
		"model.bundle": "org.eclipse.fennec.services.broker.rest",
		"model.entry": "broker-implementations-api.xmi",
		"osgi.jakartars.application.base": "/implementations",
		"fennec.auth": "$[env:DDSR_AUTH_MODE;default=$[prop:fennec.auth.mode;default=bearer]]",
		"osgi.jakartars.extension.select": "(osgi.jakartars.name=fennec-auth-$[env:DDSR_AUTH_MODE;default=$[prop:fennec.auth.mode;default=bearer]])"
	},
	"org.eclipse.fennec.services.provider.rest~brokerLookup":
	{
		"ddsr.contract": "BrokerLookup",
		"service.filter": "(ddsr.contract=BrokerLookup)",
		"model.bundle": "org.eclipse.fennec.services.broker.rest",
		"model.entry": "broker-lookup-api.xmi",
		"osgi.jakartars.application.base": "/references",
		"fennec.auth": "$[env:DDSR_AUTH_MODE;default=$[prop:fennec.auth.mode;default=bearer]]",
		"osgi.jakartars.extension.select": "(osgi.jakartars.name=fennec-auth-$[env:DDSR_AUTH_MODE;default=$[prop:fennec.auth.mode;default=bearer]])"
	}
}
