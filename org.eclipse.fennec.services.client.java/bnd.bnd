Bundle-Name: Gecko DDSR Java Client SDK
Bundle-Description: \
	Transport-agnostic Java client facade. Exposes DdsrProvider \
	(publish/withdraw) and DdsrConsumer (lookup) atop BrokerCatalog / \
	BrokerImplementations / BrokerLookup OSGi services — wire flavor \
	(REST, MQTT, embedded) is selected via which provider of those \
	services is wired in.

-library: enableEMF

-buildpath: \
	osgi.core;version=latest,\
	org.osgi.service.condition;version=latest,\
	org.osgi.service.cm;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.metatype.annotations;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.osgi.util.pushstream;version=latest,\
	org.osgi.util.function;version=latest,\
	org.eclipse.fennec.services.model;version=snapshot,\
	org.eclipse.fennec.services.api;version=snapshot,\
	org.eclipse.fennec.services.runtime;version=snapshot,\
	org.eclipse.fennec.services.xmi.codec;version=snapshot

# Plain JUnit, no OSGi runtime — the listener registry takes its event
# source as a constructor argument, so it needs no framework.
#
# junit-platform-launcher is not part of the ${junit} macro from the
# fennec osgitest library, but Gradle needs one matching the
# platform-engine version.
-testpath: \
	${junit},\
	junit-platform-launcher;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.osgi.util.function;version=latest,\
	org.osgi.util.pushstream;version=latest

# A proxy hands a caller the stream type its interface declares, and one
# of the two is the OSGi PushStream. Optional: a client that has no such
# interface needs no pushstream bundle, and one that has brings the
# package with the interface — the class that touches it (PushStreamOf)
# is loaded only then.
Import-Package: \
	org.osgi.util.pushstream;resolution:=optional,\
	org.osgi.util.promise;resolution:=optional,\
	org.osgi.util.function;resolution:=optional,\
	*
