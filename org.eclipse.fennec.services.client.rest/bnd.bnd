Bundle-Name: Gecko DDSR Java Client — REST Flavor
Bundle-Description: \
	Registers BrokerCatalog, BrokerImplementations and BrokerLookup as OSGi \
	services that proxy operations to a remote DDSR broker over HTTP+XMI \
	using the Jakarta REST Client API and the shared xmi.codec providers. \
	Embedded callers (DdsrProvider/Consumer in client.java) reference the \
	same three interfaces — the wire is transparent.

-library: enableJakartaREST, enableEMF

-buildpath: \
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.metatype.annotations;version=latest,\
	org.osgi.service.condition;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.eclipse.fennec.services.model;version=snapshot,\
	org.eclipse.fennec.services.api;version=snapshot,\
	org.eclipse.fennec.services.flavor.rest;version=snapshot,\
	org.eclipse.fennec.services.cloudevents;version=snapshot,\
	io.cloudevents.model;version=latest,\
	org.eclipse.fennec.services.xmi.codec;version=snapshot,\
	org.eclipse.fennec.services.client.java;version=snapshot

# Plain JUnit 5 (no OSGi runtime). jersey-common provides the JAX-RS
# RuntimeDelegate that Response.status(...).build() needs at runtime.
-testpath: \
	jakarta.json-api;version=latest,\
	org.eclipse.parsson.jakarta.json;version=latest,\
	${junit},\
	junit-platform-launcher;version=latest,\
	org.glassfish.jersey.core.jersey-common;version=latest,\
	jakarta.inject.jakarta.inject-api;version=latest,\
	jakarta.annotation-api;version=latest,\
	org.glassfish.hk2.osgi-resource-locator;version=latest
