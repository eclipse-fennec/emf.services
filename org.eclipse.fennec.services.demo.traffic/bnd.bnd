Bundle-Name: Fennec Services Demo Traffic
Bundle-Description: \
	A consumer that keeps calling, so a dashboard has something to \
	show. Discovery, invocation and release on a timer — the three \
	stages any consumer goes through, on repeat. \
	\
	Demo scaffolding: it takes ConfigurationPolicy.REQUIRE, so even \
	where this bundle is installed it stays quiet until a launch asks \
	for traffic.

-library: enableEMF

-buildpath: \
	osgi.core;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.metatype.annotations;version=latest,\
	org.eclipse.fennec.services.model;version=snapshot,\
	org.eclipse.fennec.services.api;version=snapshot,\
	org.eclipse.fennec.services.client.java;version=snapshot

-includeresource: \
	OSGI-INF/configurator/=configs/
Require-Capability: osgi.extender;filter:='(osgi.extender=osgi.configurator)'
