Bundle-Name: Fennec Services Contract Derivation
Bundle-Description: \
	Derives a services contract from a plain Java interface. The building \
	block the RSA facade needs to export an ordinary OSGi service (#24), \
	and useful on its own to a provider that would rather not write its \
	contract by hand.

-library: enableEMF

-buildpath: \
	org.eclipse.fennec.services.model;version=snapshot

# xmi.codec only for the test: the point of deriving deterministically
# is the fingerprint, so the test pins the fingerprint.
-testpath: \
	${junit},\
	junit-platform-launcher;version=latest,\
	org.eclipse.fennec.services.xmi.codec;version=snapshot
