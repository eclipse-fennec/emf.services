{
  ":configurator:resource-version": 1,

  "org.apache.felix.http~paymentsHttp":
  {
    "org.osgi.service.http.port": "$[env:PAYMENTS_HTTP_PORT;default=9091]",
    "org.osgi.service.http.host": "0.0.0.0",
    "org.apache.felix.http.context_path": "payments",
    "org.apache.felix.http.name": "Payments HTTP",
    "org.apache.felix.http.runtime.init.id": "paymentsHttp"
  },
  "JakartarsServletWhiteboardRuntimeComponent~paymentsRest":
  {
    "jersey.jakartars.whiteboard.name": "Payments Rest",
    "osgi.http.whiteboard.target": "(id=paymentsHttp)"
  },
  "org.eclipse.fennec.services.client.rest":
  {
    "broker.url": "$[env:DDSR_BROKER_URL;default=http://localhost:8887/ddsr/rest]"
  },
  "org.eclipse.fennec.services.client":
  {
    "provider.heartbeat.seconds": "$[env:DDSR_PROVIDER_HEARTBEAT_SECONDS;default=30]",
    "session.interval.seconds": "$[env:DDSR_SESSION_INTERVAL_SECONDS;default=0]"
  },
  "org.eclipse.fennec.services.provider.rest~bindingProbe":
  {
    "ddsr.contract": "BindingProbe",
    "service.filter": "(ddsr.contract=BindingProbe)",
    "model.bundle": "org.eclipse.fennec.services.examples.payment",
    "model.entry": "model/binding-probe.xmi",
    "osgi.jakartars.application.base": "/probe",
    "publish": "$[env:PAYMENTS_PUBLISH_BINDING_PROBE;default=false]",
    "public.url": "$[env:PAYMENTS_PUBLIC_URL;default=http://localhost:9091/payments]",
    "broker.url": "$[env:DDSR_BROKER_URL;default=http://localhost:8887/ddsr/rest]"
  },
  "org.eclipse.fennec.services.provider.mqtt~bindingProbeMqtt":
  {
    "ddsr.contract": "BindingProbe",
    "service.filter": "(ddsr.contract=BindingProbe)",
    "model.bundle": "org.eclipse.fennec.services.examples.payment",
    "model.entry": "model/binding-probe-mqtt.xmi",
    "publish": "$[env:PAYMENTS_PUBLISH_BINDING_PROBE_MQTT;default=false]",
    "mqtt.broker": "$[env:PAYMENTS_MQTT_URL;default=]",
    "broker.url": "$[env:DDSR_BROKER_URL;default=http://localhost:8887/ddsr/rest]"
  },
  "org.eclipse.fennec.services.provider.rest~personStore":
  {
    "ddsr.contract": "PersonStore",
    "service.filter": "(ddsr.contract=PersonStore)",
    "model.bundle": "org.eclipse.fennec.services.examples.payment",
    "model.entry": "model/person-store.xmi",
    "osgi.jakartars.application.base": "/persons",
    "publish": "$[env:PAYMENTS_PUBLISH_PERSON_STORE;default=false]",
    "public.url": "$[env:PAYMENTS_PUBLIC_URL;default=http://localhost:9091/payments]",
    "broker.url": "$[env:DDSR_BROKER_URL;default=http://localhost:8887/ddsr/rest]"
  },
  "org.eclipse.fennec.services.examples.payment":
  {
    "public.url": "$[env:PAYMENTS_PUBLIC_URL;default=http://localhost:9091/payments]",
    "broker.url": "$[env:DDSR_BROKER_URL;default=http://localhost:8887/ddsr/rest]",
    "provider.name": "$[env:PAYMENTS_PROVIDER_NAME;default=payments-java]",
    "impl.version": "$[env:PAYMENTS_IMPL_VERSION;default=1.0.0]",
    "update.policy": "$[env:PAYMENTS_UPDATE_POLICY;default=UNSPECIFIED]",
    "replaces.version": "$[env:PAYMENTS_REPLACES_VERSION;default=]"
  }
}
