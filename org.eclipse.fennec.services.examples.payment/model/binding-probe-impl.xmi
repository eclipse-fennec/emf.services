<?xml version="1.0" encoding="UTF-8"?>
<services:ServiceProvider xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:services="http://eclipse.org/fennec/services/1.0"
    name="binding-probe-java">
  <implementations name="binding-probe-java" version="1.0.0"
      implementationId="binding-probe:java:1.0.0"
      serviceInterfaces="binding-probe.xmi#/">
    <flavors xsi:type="services:RestFlavor" name="binding-probe-rest" kind="REST" basePath="/probe">
      <operationFlavors xsi:type="services:RestOperationFlavor" name="echo"
          method="GET" path="/echo/{id}" returnCodes="200" produces="text/plain"
          operation="binding-probe.xmi#//@operations.0">
        <parameterBindings parameter="binding-probe.xmi#//@operations.0/@parameters.0" binding="PATH"/>
        <parameterBindings parameter="binding-probe.xmi#//@operations.0/@parameters.1" binding="QUERY"/>
        <parameterBindings parameter="binding-probe.xmi#//@operations.0/@parameters.2" binding="HEADER" wireName="X-Tenant"/>
      </operationFlavors>
    </flavors>
  </implementations>
</services:ServiceProvider>
