Bundle-Name: Fennec Services Example Consumer
Bundle-Description: \
	The example consumers of the harness's Java client: calls the PersonStore \
	contract, whose argument and result are models and whose wire encoding is \
	protobuf, and the Payment contract of the TypeScript provider. Lives in its \
	own bundle because the SDK must not depend on an example model nor start \
	examples (#268), and because the provider bundle brings its own \
	configuration — putting this in either would publish a second provider or \
	drag a demo model into the broker.

-buildpath: \
	org.osgi.service.component.annotations;version=latest,\
	osgi.core;version=latest,\
	org.eclipse.emf.common;version=latest,\
	org.eclipse.emf.ecore;version=latest,\
	org.eclipse.fennec.services.model;version=snapshot,\
	org.eclipse.fennec.services.client.java;version=snapshot,\
	org.eclipse.fennec.services.examples.model;version=snapshot

# The consumer launch (client.bndrun) has no other configuration bundle:
# where the broker is, which id the session carries, and — against a
# broker in mode bearer — how this node gets its token, all from the
# environment (DDSR_BROKER_URL, DDSR_CONSUMER_ID, DDSR_OAUTH_*). Empty
# variables leave the client exactly as it was without this file.
-includeresource: \
	OSGI-INF/configurator/=configs/
Require-Capability: osgi.extender;filter:='(osgi.extender=osgi.configurator)'

# An example, run from this workspace: never released to Maven Central
# (#261 - every file is a request, and Central's snapshot repository
# rate-limits a burst of them).
-maven-release: local
