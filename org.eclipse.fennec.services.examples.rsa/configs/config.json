{
  ":configurator:resource-version": 1,
  "org.eclipse.fennec.services.examples.rsa.greeter": {
    "service.exported.interfaces": "*",
    "service.exported.configs": "$[env:RSA_EXPORT_CONFIGS;default=fennec.rest]",
    "ddsr.provider.name": "rsa-example"
  },
  "org.eclipse.fennec.services.examples.rsa.ledger": {
    "service.exported.interfaces": "*",
    "service.exported.configs": "$[env:RSA_EXPORT_CONFIGS;default=fennec.rest]",
    "ddsr.provider.name": "rsa-example"
  },
  "org.eclipse.fennec.services.rsa.provider": {
    "token.uri": "$[env:DDSR_OAUTH_TOKEN_URI;default=]",
    "client.id": "$[env:DDSR_OAUTH_CLIENT_ID;default=]",
    "client.secret": "$[env:DDSR_OAUTH_CLIENT_SECRET;default=]",
    "scope": "$[env:DDSR_OAUTH_SCOPE;default=]",
    "issuer": "$[env:DDSR_JWT_ISSUER;default=]",
    "jwks.uri": "$[env:DDSR_JWT_JWKS_URI;default=]",
    "audiences": "$[env:DDSR_JWT_AUDIENCES;default=;type=String[];delimiter=,]",
    "scope.claim": "$[env:DDSR_JWT_SCOPE_CLAIM;default=scope]",
    "subject.claim": "$[env:DDSR_JWT_SUBJECT_CLAIM;default=sub]",
    "broker.url": "$[env:DDSR_BROKER_URL;default=http://localhost:8887/ddsr/rest]",
    "broker.authentication": "$[env:DDSR_BROKER_AUTHENTICATION;default=token]",
    "tls.keystore": "$[env:DDSR_TLS_KEYSTORE;default=]",
    "tls.keystore.password": "$[env:DDSR_TLS_KEYSTORE_PASSWORD;default=]",
    "tls.truststore": "$[env:DDSR_TLS_TRUSTSTORE;default=]",
    "tls.truststore.password": "$[env:DDSR_TLS_TRUSTSTORE_PASSWORD;default=]",
    "http.port": "$[env:RSA_HTTP_PORT;default=9095]",
    "http.id": "rsaHttp",
    "context.path": "services",
    "public.host": "$[env:RSA_PUBLIC_HOST;default=localhost]",
    "registry.name": "rsa-example",
    "distribution.flavor": "$[env:RSA_DISTRIBUTION_FLAVOR;default=]",
    "discovery.flavor": "$[env:RSA_DISCOVERY_FLAVOR;default=]",
    "mqtt.url": "$[env:RSA_MQTT_URL;default=tcp://localhost:1883]",
    "topic.prefix": "$[env:RSA_TOPIC_PREFIX;default=ddsr/rpc]",
    "provider.heartbeat.seconds": "30",
    "session.interval.seconds": "0"
  }
}
