Bundle-Name: Fennec Services Messaging Flavor Rules
Bundle-Description: \
	Where a call travels over a messaging broker, whichever protocol the \
	broker speaks: the rules both ends read a MessagingFlavor by — which \
	channel an operation is reached on, where its answer goes, what it \
	is encoded in — and the route they make of them. What a protocol \
	changes is what a channel is called (a topic with '/' levels, a \
	routing key with '.' segments); the rest is the same, and is written \
	once. No client: this bundle decides, it does not connect.

-library: enableEMF

-buildpath: \
	org.eclipse.fennec.services.model;version=snapshot,\
	org.eclipse.fennec.services.api;version=snapshot,\
	org.eclipse.fennec.services.cloudevents;version=snapshot,\
	io.cloudevents.model;version=latest

-testpath: \
	${junit},\
	junit-platform-launcher;version=latest,\
	jakarta.json-api;version=latest,\
	org.eclipse.parsson.jakarta.json;version=latest
