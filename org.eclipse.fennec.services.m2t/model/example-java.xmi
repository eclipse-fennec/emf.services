  <typeMappings neutralType="fennec.services.example.PersonNotFound"
      target="org.eclipse.fennec.services.m2t.example.PersonNotFoundException"
      generated="true"/>
  <packageMappings nsURI="http://geckoprojects.org/ddsr/example"
      target="org.eclipse.fennec.services.examples.model.ddsrexample"/>
