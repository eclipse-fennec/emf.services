<services:JavaBinding xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:services="http://eclipse.org/fennec/services/1.0"
    name="example-java"
    targetPackage="org.eclipse.fennec.services.m2t.example"
    apiType="PROVIDER">
