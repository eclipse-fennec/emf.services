<?xml version="1.0" encoding="UTF-8"?>
<service:ServiceProvider
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:service="http://eclipse.org/fennec/service/1.0"
    xsi:schemaLocation="http://eclipse.org/fennec/service/1.0 service.ecore"
    name="MyFancyServiceProvider">
  <providedServiceRef
      name="PaymentServiceRef"
      filter="(payment.provider=PayPal)"
      cardMin="1">
    <type href="ServiceRegistry.xmi#PaymentService"/>
  </providedServiceRef>
</service:ServiceProvider>
