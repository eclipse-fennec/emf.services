Bundle-Name: Fennec Services AMQP Distribution
Bundle-Description: \
	Serves a contract over AMQP 0-9-1 without generated code: one \
	binding per operation of a flavor, a dispatcher that reads the call, \
	invokes the service behind it and answers to the reply address the \
	call itself named. The third transport on the pattern the REST and \
	MQTT distributions set — the model is the only source, and the \
	connection is a messaging link.

-library: enableEMF

-buildpath: \
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.metatype.annotations;version=latest,\
	org.eclipse.fennec.services.messaging;version=snapshot,\
	org.gecko.messaging.api;version=latest,\
	org.eclipse.fennec.services.model;version=snapshot,\
	org.eclipse.fennec.services.api;version=snapshot,\
	org.eclipse.fennec.services.cloudevents;version=snapshot,\
	io.cloudevents.model;version=latest,\
	org.eclipse.fennec.services.flavor.amqp;version=snapshot,\
	org.eclipse.fennec.services.xmi.codec;version=snapshot,\
	osgi.core;version=latest

# Plain JUnit 5: the dispatcher takes its service and its way back as
# seams, so what it decides is exercised without a broker.
-testpath: \
	${junit},\
	junit-platform-launcher;version=latest,\
	jakarta.json-api;version=latest,\
	org.eclipse.parsson.jakarta.json;version=latest
