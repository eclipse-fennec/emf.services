Bundle-Name: Fennec Services Generic Messaging Distribution
Bundle-Description: \
	Serves a contract over a messaging broker without generated code: \
	one subscription per operation of a configured flavor, a dispatcher \
	that reads the call, invokes the service behind it and answers the \
	way the call asks to be answered. One distribution for MQTT and \
	AMQP, because over messaging the API is the same and the flavor \
	says the rest; which protocols it can speak is decided by the \
	messaging bindings the launch carries. The model is the only source \
	— nothing here is written per contract.

-library: enableEMF

-buildpath: \
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.metatype.annotations;version=latest,\
	org.eclipse.fennec.services.messaging;version=snapshot,\
	org.gecko.messaging.api;version=latest,\
	org.eclipse.fennec.services.model;version=snapshot,\
	org.eclipse.fennec.services.api;version=snapshot,\
	org.eclipse.fennec.services.cloudevents;version=snapshot,\
	io.cloudevents.model;version=latest,\
	org.eclipse.fennec.services.flavor.messaging;version=snapshot,\
	org.eclipse.fennec.services.xmi.codec;version=snapshot,\
	org.eclipse.fennec.services.client.java;version=snapshot,\
	org.osgi.service.cm;version=latest,\
	osgi.core;version=latest

# Plain JUnit 5: the dispatcher takes its publisher and its service as
# seams, so what it decides is exercised without a broker.
-testpath: \
	${junit},\
	junit-platform-launcher;version=latest,\
	jakarta.json-api;version=latest,\
	org.eclipse.parsson.jakarta.json;version=latest
