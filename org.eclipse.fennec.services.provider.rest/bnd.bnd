Bundle-Name: Fennec Services Generic REST Distribution
Bundle-Description: \
	Serves a contract over REST without generated code: one Jakarta REST \
	application per configured implementation, whose dispatcher routes a \
	request to an operation through the flavor and invokes the service \
	behind it. The model is the only source — nothing here is written per \
	contract.

-library: enableJakartaREST, enableEMF

-buildpath: \
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.metatype.annotations;version=latest,\
	org.osgi.service.jakartars;version=latest,\
	org.eclipse.fennec.services.model;version=snapshot,\
	org.eclipse.fennec.services.flavor.rest;version=snapshot,\
	org.eclipse.fennec.services.xmi.codec;version=snapshot,\
	org.eclipse.fennec.services.client.java;version=snapshot,\
	org.eclipse.fennec.services.api;version=snapshot

# Plain JUnit 5, no OSGi runtime: the dispatcher decides in model terms
# and takes its service lookup as a supplier, so nothing here needs a
# framework. jersey-common supplies the JAX-RS RuntimeDelegate that
# building a Response needs.
-testpath: \
	${junit},\
	junit-platform-launcher;version=latest,\
	org.glassfish.jersey.core.jersey-common;version=latest
