Bundle-Name: Fennec Services RSA AMQP Distribution
Bundle-Description: \
	Makes an exported service reachable over the AMQP flavor: the contract \
	is derived from the interface, a flavor is built that says which \
	routing keys answer for it, and the generic AMQP distribution answers \
	calls by invoking the service. Selected by the RSA configuration type \
	fennec.amqp — the third implementation of the same SPI.

-library: enableEMF

-buildpath: \
	osgi.core;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.metatype.annotations;version=latest,\
	org.eclipse.fennec.services.model;version=snapshot,\
	org.eclipse.fennec.services.provider.amqp;version=snapshot,\
	org.eclipse.fennec.services.rsa;version=snapshot

-testpath: \
	${junit},\
	junit-platform-launcher;version=latest,\
	org.eclipse.fennec.services.api;version=snapshot

# What the Remote Service Admin specification asks a distribution provider
# to say about itself (122.10): which configuration types it exports with.
Provide-Capability: \
	osgi.remoteserviceadmin.distribution;configs:List<String>="fennec.amqp";version:Version="1.1"
