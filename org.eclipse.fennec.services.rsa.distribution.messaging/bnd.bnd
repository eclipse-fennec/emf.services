Bundle-Name: Fennec Services RSA Messaging Distribution
Bundle-Description: \
	Makes an exported service reachable over a messaging broker: the \
	contract is derived from the interface, a flavor is built that says \
	which channels answer for it, and the messaging distribution answers \
	calls by invoking the service. One provider per RSA configuration \
	type — fennec.mqtt and fennec.amqp — because what differs between \
	them is the flavor each builds; the distribution behind both is the \
	same.

-library: enableEMF

-buildpath: \
	osgi.core;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.metatype.annotations;version=latest,\
	org.eclipse.fennec.services.model;version=snapshot,\
	org.eclipse.fennec.services.provider.messaging;version=snapshot,\
	org.eclipse.fennec.services.rsa;version=snapshot

-testpath: \
	${junit},\
	junit-platform-launcher;version=latest,\
	org.eclipse.fennec.services.api;version=snapshot

# What the Remote Service Admin specification asks a distribution provider
# to say about itself (122.10): which configuration types it exports with.
Provide-Capability: \
	osgi.remoteserviceadmin.distribution;configs:List<String>="fennec.mqtt,fennec.amqp";version:Version="1.1"
