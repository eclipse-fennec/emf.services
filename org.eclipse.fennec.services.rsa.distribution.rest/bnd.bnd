Bundle-Name: Fennec Services RSA REST Distribution
Bundle-Description: \
	Makes an exported service reachable over the REST flavor: the contract \
	is derived from the interface, a flavor is built for it, and the \
	generic distribution answers requests by calling the service. Selected \
	by the RSA configuration type fennec.rest.

-library: enableEMF

-buildpath: \
	osgi.core;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.metatype.annotations;version=latest,\
	org.eclipse.fennec.services.model;version=snapshot,\
	org.eclipse.fennec.services.provider.rest;version=snapshot,\
	org.eclipse.fennec.services.rsa;version=snapshot

-testpath: \
	${junit},\
	junit-platform-launcher;version=latest,\
	org.eclipse.fennec.services.derive;version=snapshot

# What the Remote Service Admin specification asks a distribution provider
# to say about itself (122.10): which configuration types it exports with.
Provide-Capability: \
	osgi.remoteserviceadmin.distribution;configs:List<String>="fennec.rest";version:Version="1.1"
