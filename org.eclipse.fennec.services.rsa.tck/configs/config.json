{
  ":configurator:resource-version": 1,
  "org.eclipse.fennec.services.rsa.provider": {
    "broker.url": "$[prop:rsa.tck.broker.url;default=http://localhost:8887/ddsr/rest]",
    "http.port": "$[prop:rsa.tck.http.port;default=9096]",
    "http.id": "tckHttp",
    "context.path": "services",
    "registry.name": "rsa-tck",
    "policy": "manual",
    "provider.heartbeat.seconds": "5",
    "session.interval.seconds": "0"
  }
}
