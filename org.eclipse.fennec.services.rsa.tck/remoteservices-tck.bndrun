	${repo;org.opentest4j;[1.3.0,1.3.1)},\
	${repo;org.osgi.service.component;[1.5.1,1.5.2)},\
	${repo;org.osgi.service.jakartars;[2.0.0,2.0.1)},\
	${repo;org.osgi.service.remoteserviceadmin;[1.1.0,1.1.1)},\
	${repo;org.osgi.service.servlet;[2.0.0,2.0.1)},\
