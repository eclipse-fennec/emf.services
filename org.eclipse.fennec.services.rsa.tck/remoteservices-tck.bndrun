# The secondary TCK named in #24: OSGi Remote Services (chapter 100).
# Where the Remote Service Admin TCK exercises the API, this one exercises
# what actually travels — BasicTypes, DTOs, async return types — between two
# frameworks. It is one test class, SimpleTest, and the bundle carries its
# own `common` package, so no companion artifact is needed.
#
# Generated from rsa-tck.bndrun; the two differ only in which TCK bundle is
# run and in the property prefix `p`.
#
# STATUS: it resolves and runs, and every test reports the same thing —
# "No DistributionProvider found". Chapter 100 recognises a distribution
# provider by a service carrying BOTH `remote.configs.supported` and
# `remote.intents.supported`. The admin carries the first, from its
# configuration, and not the second.
#
# Adding the missing property is one line, and doing it now would be a
# claim we cannot back: nothing here enforces an intent. `osgi.basic`
# alone asks for argument-type fidelity and timeout behaviour that no
# test of ours covers. So the launch stays as it is — a reproducible
# statement of exactly how far this implementation is from the secondary
# TCK, rather than a green run bought with a false declaration (#24).
# Equinox, the reference framework the OSGi workspace runs this TCK on. The
# TCK bootstraps its child framework from bundle 0's own entries
# (getBundle(0).getEntry("/META-INF/services/…FrameworkFactory")), which
# Felix's system bundle does not serve; six tests failed before testing
# anything. The RSA implementation is framework-neutral, so nothing else
# changes — except that class-space checks may judge differently than
# Felix did (see ProxyHost).
-runfw: org.eclipse.osgi

-runee: JavaSE-21

-runsystemcapabilities: ${native_capability}

-resolve.effective: active;skip:="osgi.service"

# Brings in Jersey server + Jakartars whiteboard
-library: enableJakartaREST

# The library contributes -runbundles.jersey with a SECOND, older HTTP
# stack (org.apache.felix.http.jetty 5.x + servlet-api 2.1 + slf4j 1.7)
# on top of the jetty12 bundles pinned below — two competing HTTP
# whiteboards in every launch, which made container startups take
# minutes (found by the FR-P4 podman harness). All required Jersey
# bundles are pinned explicitly in -runbundles, so the library's list
# is emptied here.
jersey.deps:

# The TCK bundle is run by the bnd tester; its Test-Cases header names the
# JUnit 4 classes. The vintage engine runs them on the JUnit platform.
-tester: biz.aQute.tester.junit-platform

-runrequires: \
	bnd.identity;id='org.osgi.test.cases.remoteservices',\
	bnd.identity;id='org.apache.servicemix.bundles.junit',\
	bnd.identity;id='junit-vintage-engine',\
	bnd.identity;id='org.apache.felix.eventadmin',\
	bnd.identity;id='org.eclipse.fennec.services.rsa',\
	bnd.identity;id='org.eclipse.fennec.services.rsa.config',\
	bnd.identity;id='org.eclipse.fennec.services.rsa.distribution.rest',\
	bnd.identity;id='org.eclipse.fennec.services.rsa.discovery.rest',\
	bnd.identity;id='org.eclipse.fennec.services.rsa.discovery.local',\
	bnd.identity;id='org.eclipse.fennec.services.rsa.topology',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.eobject.registry',\
	bnd.identity;id='org.eclipse.fennec.services.client.java',\
	bnd.identity;id='org.eclipse.fennec.services.client.rest',\
	bnd.identity;id='org.eclipse.fennec.services.provider.rest',\
	bnd.identity;id='org.apache.felix.configadmin.plugin.interpolation'

-runblacklist: \
	bnd.identity;id='org.osgi.service.cm'

# What the TCK reads (TCK_README.txt). p is its property prefix. The child
# framework shares the JVM and the configuration; its HTTP port must differ
# from the parent's, and the configuration reads it from the framework
# property handed over in framework.properties. rsa.tck.timeout is how long
# the test bundles wait for the admin before exporting — the child takes a
# while to bring its transports up. (No comments inside the continuation:
# bnd reads them as part of the value.)
p: org.osgi.test.cases.remoteservices
-runproperties: \
	org.osgi.service.http.port=-1,\
	felix.cm.config.plugins=org.apache.felix.configadmin.plugin.interpolation,\
	rsa.tck.timeout=60000,\
	rsa.tck.timeout.factor=3,\
	${p}.framework.properties="rsa.tck.http.port=9097",\
	${p}.system.packages.extra="",\
	${p}.serverconfig="service.exported.configs,service.exported.intents",\
	service.exported.configs="fennec.rest",\
	service.exported.intents="osgi.basic",\
	${p}.bundles="${runbundles.files}"

# Every bundle of this launch also goes into the child framework: the TCK
# installs them from file paths, then adds its own test bundles — which
# import from the TCK bundle, JUnit 4 and AssertJ, so those go too; the
# tester itself is runpath, not a bundle, and the engines sit idle there.
# Generated from -runbundles; regenerate when that changes. Repository
# bundles carry the resolved range — 'latest' would hand the child the
# index's highest version, not the one the parent runs.
# The child starts these in list order, and the order matters: the
# configuration stack and the bundle that carries the configurations go
# first, so every configuration exists in Configuration Admin before a
# component that requires one registers with SCR. Started alphabetically,
# our component bundles came up before the configuration bundle, and in
# roughly one child in seven a configuration written afterwards was never
# delivered — present in Configuration Admin, unknown to the component.
runbundles.files: ${uniq;\
	${repo;org.apache.felix.configadmin;[1.9.26,1.9.27)},\
	${repo;org.apache.felix.cm.json;[2.0.6,2.0.7)},\
	${repo;org.apache.felix.configadmin.plugin.interpolation;[1.2.8,1.2.9)},\
	${repo;org.apache.felix.configurator;[1.0.18,1.0.19)},\
	${repo;org.osgi.test.cases.remoteservices;[8.1.0,8.1.1)},\
	${repo;assertj-core;[3.27.7,3.27.8)},\
	${repo;jakarta.activation-api;[2.1.3,2.1.4)},\
	${repo;jakarta.annotation-api;[2.1.1,2.1.2)},\
	${repo;jakarta.inject.jakarta.inject-api;[2.0.1,2.0.2)},\
	${repo;jakarta.validation.jakarta.validation-api;[3.0.2,3.0.3)},\
	${repo;jakarta.ws.rs-api;[3.1.0,3.1.1)},\
	${repo;jakarta.xml.bind-api;[4.0.2,4.0.3)},\
	${repo;javassist;[3.29.2,3.29.3)},\
	${repo;junit-platform-commons;[1.14.2,1.14.3)},\
	${repo;junit-platform-engine;[1.14.2,1.14.3)},\
	${repo;junit-platform-launcher;[1.14.2,1.14.3)},\
	${repo;junit-vintage-engine;[5.14.2,5.14.3)},\
