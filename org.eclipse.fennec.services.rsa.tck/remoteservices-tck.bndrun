	${repo;org.eclipse.fennec.emf.osgi.eobject.registry;[1.1.0,1.1.1)},\
	${repo;org.eclipse.fennec.services.api;latest},\
	${repo;org.eclipse.fennec.services.client.java;latest},\
	${repo;org.eclipse.fennec.services.client.rest;latest},\
	${repo;org.eclipse.fennec.services.flavor.rest;latest},\
