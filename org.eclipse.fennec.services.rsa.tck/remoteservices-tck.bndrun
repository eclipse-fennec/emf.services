	${repo;org.glassfish.hk2.external.aopalliance-repackaged;[3.0.5,3.0.6)},\
	${repo;org.glassfish.hk2.locator;[3.0.5,3.0.6)},\
	${repo;org.glassfish.hk2.osgi-resource-locator;[1.0.3,1.0.4)},\
	${repo;org.glassfish.hk2.utils;[3.0.5,3.0.6)},\
	${repo;org.glassfish.jersey.containers.jersey-container-servlet;[3.1.3,3.1.4)},\
