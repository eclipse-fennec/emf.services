Bundle-Name: Fennec Services RSA Topology
Bundle-Description: \
	Decides what gets exported. Remote Service Admin deliberately does not: \
	it exports what it is told to, and this is what tells it.

Private-Package: \
	org.eclipse.fennec.services.rsa.topology

-library: enableEMF

-buildpath: \
	osgi.core;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.remoteserviceadmin;version=latest,\
	org.osgi.util.tracker;version=latest,\
	org.eclipse.fennec.services.model;version=snapshot,\
	org.eclipse.fennec.services.rsa;version=snapshot

-testpath: \
	${junit},\
	junit-platform-launcher;version=latest
