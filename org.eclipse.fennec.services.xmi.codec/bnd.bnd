Bundle-Name: Fennec Services XMI Codec
Bundle-Description: \
	Shared XMI <-> EObject codec: what a model is on the wire, in the \
	encoding a content type names, with a bound on what is read. Knows no \
	transport; its Jakarta REST providers are xmi.codec.jakartars (#265).

-library: enableEMF

-buildpath: \
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.component;version=latest,\
	org.eclipse.fennec.services.model;version=snapshot

# Plain JUnit, no OSGi runtime — the codec is static and the only OSGi
# API it touches (ComponentServiceObjects) is trivially mockable.
#
# junit-platform-launcher is not part of the ${junit} macro from the
# fennec osgitest library, but Gradle needs one that matches the
# platform-engine version. Without it Gradle falls back to its own
# bundled launcher and test discovery dies with "OutputDirectoryCreator
# not available; probably due to unaligned versions".
-testpath: \
	${junit},\
	junit-platform-launcher;version=latest,\
	org.eclipse.fennec.protobuf;version=latest,\
	com.google.protobuf;version=latest
